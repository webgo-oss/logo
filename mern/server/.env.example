PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/unstoppable_logos

# Admin account (created automatically when the server starts)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password

# Long random text used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
